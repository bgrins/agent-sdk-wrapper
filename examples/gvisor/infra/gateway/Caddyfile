{
	admin off
	auto_https off
	persist_config off
	grace_period 2s
}

(request) {
	request_body {
		max_size 16MB
	}
}

(proxy) {
	header_up Host {upstream_hostport}
	header_up -Proxy-Authorization
	header_up -OpenAI-Organization
	header_up -OpenAI-Project
	header_up -X-Forwarded-*
	flush_interval -1
	stream_timeout 150s
	transport http {
		response_header_timeout 150s
		read_timeout 150s
	}
	@redirect status 3xx
	handle_response @redirect {
		respond 502
	}
}

http:// {
	bind {$GATEWAY_LISTEN:unix//socket/gateway.sock|0666}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
			}
		}
	}
	# Match the raw request target: path matchers clean and case-fold it, but the proxy forwards it as sent.
	# Betas are those the pinned SDKs send; the list excludes the MCP connector.
	@claude {
		expression `
			{env.PROVIDER} == "anthropic" &&
			{http.request.uri}.matches("^/v1/messages(/count_tokens)?([?][^#]*)?$") &&
			{http.request.header.anthropic-beta}.matches("^((" +
				"claude-code-20250219|context-1m-2025-08-07|context-management-2025-06-27|" +
				"effort-2025-11-24|fallback-credit-2026-06-01|interleaved-thinking-2025-05-14|" +
				"mid-conversation-system-2026-04-07|per-turn-control-2026-07-01|" +
				"prompt-caching-scope-2026-01-05|thinking-token-count-2026-05-13|" +
				"token-counting-2024-11-01" +
				")(,|$))*$")
		`
		header X-Api-Key {env.GATEWAY_TOKEN}
		method POST
	}
	@codex {
		expression `
			{env.PROVIDER} == "openai" &&
			{http.request.uri}.matches("^/v1/(responses(/compact)?|models)([?][^#]*)?$")
		`
		header Authorization "Bearer {env.GATEWAY_TOKEN}"
		method GET POST
	}
	handle @claude {
		import request
		reverse_proxy {$ANTHROPIC_UPSTREAM:https://api.anthropic.com} {
			header_up -Authorization
			header_up X-Api-Key {env.UPSTREAM_KEY}
			import proxy
		}
	}
	handle @codex {
		import request
		reverse_proxy {$OPENAI_UPSTREAM:https://api.openai.com} {
			header_up -X-Api-Key
			header_up Authorization "Bearer {env.UPSTREAM_KEY}"
			import proxy
		}
	}
	respond 403
}
