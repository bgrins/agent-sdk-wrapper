{
  "name": "agent-sdk-wrapper-workspace",
  "private": true,
  "workspaces": ["packages/typescript"],
  "scripts": {
    "verify": "npm test && npm run typecheck && npm run lint && npm run format:check && npm run test:package",
    "build": "npm run build --workspace agent-sdk-wrapper",
    "test": "npm run test --workspace agent-sdk-wrapper",
    "test:integration": "npm run test:integration --workspace agent-sdk-wrapper",
    "test:package": "npm run test:package --workspace agent-sdk-wrapper",
    "typecheck": "npm run typecheck --workspace agent-sdk-wrapper",
    "lint": "npm run lint --workspace agent-sdk-wrapper",
    "format:check": "npm run format:check --workspace agent-sdk-wrapper"
  }
}
