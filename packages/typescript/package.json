{
  "name": "agent-sdk-wrapper",
  "version": "0.1.0",
  "description": "Native TypeScript wrapper for the Claude Agent SDK and Codex SDK",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgrins/agent-sdk-wrapper.git",
    "directory": "packages/typescript"
  },
  "engines": {
    "node": "^22.14.0 || >=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "PARITY.md",
    "VALIDATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:test": "rm -rf .test-dist && tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test .test-dist/test/*.test.js",
    "test:integration": "npm run build:test && node --test .test-dist/test/*.integration.js",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "lint": "biome lint src test examples fixtures scripts",
    "format:check": "biome format src test examples fixtures scripts *.json",
    "format": "biome format --write src test examples fixtures scripts *.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@openai/codex-sdk": "0.154.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
